# --- Database (MySQL 8 or MariaDB 10.5+). Keep this file on the server only. Never put these in the React code. ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=global_one_sms
DB_USER=sms
DB_PASSWORD=change-this

# --- Security ---
JWT_SECRET=paste-a-long-random-string-here        # python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=admin@school.com                      # used once by `python manage.py init`
ADMIN_PASSWORD=choose-a-strong-password           # used once by `python manage.py init`
SHOW_CODES=1                                      # 1 = show the admin 2FA / reset code on screen (fine on your own computer). Use 0 on the live server.
RESET_TTL_SECONDS=60                              # password reset codes expire after this many seconds
TRUST_PROXY=0                                     # 1 when running behind nginx so audit logs show the real client IP

# --- M-Pesa (Safaricom Daraja) ---
DARAJA_ENV=sandbox                                # production when live
DARAJA_KEY=
DARAJA_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
PUBLIC_URL=https://your-domain.example            # HTTPS address Safaricom can reach for the callback
PORT=5000
